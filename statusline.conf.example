# Copy to ~/.claude/statusline.conf and uncomment what you want to change.
# Every setting is optional. A value that is not valid falls back to its default.

# Colors: sorbet (soft pastel, the default) | ember (warm amber to rose) | sunset (gold to magenta)
#STATUSLINE_THEME=sorbet

# Terminal background: dark (default) | light. Light mode is minimal: darker text, a pale inset, a pale bar track.
#STATUSLINE_BG=dark

# What happens when the window is too narrow:
#   compact  one line; shrinks to fit: shorter bars, then drops token total, cache inset and last-prompt cost, 7d, diff, 5h, worktree, cost, model
#   wrap     line 1 is model and usage (shrunk to fit), line 2 is repo:branch and the diff
#   full     never shrinks; Claude Code truncates
#STATUSLINE_LAYOUT=compact

# Columns kept free at the right edge when fitting
#STATUSLINE_MARGIN=6

# Billing: auto | plan | api
#   auto  shows 5h and 7d once your account has reported rate limits; before that it treats you as an API-key user
#   plan  always plan layout: 5h and 7d bars, cost as plain text
#   api   hides 5h and 7d and puts the cost in a pill that steps through the growth colors
#BILLING=auto
# Cost: auto | pill | text. auto is a colored pill for api billing and plain text for a plan; set pill or text to force it.
#COST_STYLE=auto
# Cents at which the cost pill moves to the next color (8 values)
#COST_STEPS="5 25 50 100 200 500 1000 2500"

# The growth pill (how much context your last prompt added)
#GROWTH_SHOW=percent       # tokens | percent | both
#GROWTH_COLOR_BY=percent   # percent scales the color steps to your context window; tokens uses fixed counts

# Segments
#SHOW_DIFF=true
#SHOW_COST=true           # false also hides the +$ last-prompt cost next to it
#SHOW_TOKENS=true
#SHOW_CACHE=true
#SHOW_GIT_COUNTS=false     # true adds staged / unstaged / ahead counts after the branch

# Seconds a git result is cached
#GIT_TTL=5
